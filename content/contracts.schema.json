  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grave-accord.invalid/contracts/v1",
  "title": "Grave Accord versioned interface contracts",
  "description": "Authored Stage 1 schemas. Runtime must use a strict validator plus semantic invariants; schema validation alone does not establish trusted combat results. Timings are seconds unless fields end in Ticks (30 Hz) or Ms.",
