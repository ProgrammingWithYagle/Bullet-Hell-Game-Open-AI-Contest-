{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "WebWorker"], "strict": true,
    "skipLibCheck": true, "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "noEmit": true, "types": ["node", "vite/client"]
  },
  "include": ["src", "tests", "vite.config.ts"]
}
