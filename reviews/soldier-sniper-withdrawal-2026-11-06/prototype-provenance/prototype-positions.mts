{
 const{s,p}=pair(),sites=s.all(p.id).map(q=>({...q}));p.x=500;p.aim=0;sync(s,p,50);const take=s.take(p,50);check(!!take&&take.point.cueId===sites[0].cueId,'choose either actual site by body/bearing');check(s.get(p.id)?.cueId===sites[1].cueId,'sole surviving second slot becomes active without a transfer');check(JSON.stringify(s.get(p.id))===JSON.stringify(sites[1]),'every original surviving field remains exact');check(s.normalClaim(p,100,take,50,0,true),'normally ready paid claim may record pair');check(!s.fallback(p,50,true),'paid reservation alone earns no fallback');check(!s.canPlaceSecond(p,true),'pending plan prevents replacement');check(s.released(p,100,51),'actual first release can arm remaining site');check(!s.fallback(p,51,true),'no remote-site credit');p.x=612;p.aim=1;sync(s,p,60);check(s.fallback(p,60,true),'actual remaining site/bearing qualifies');check(s.status(p.id).fallbackUntil===sites[1].until,'original second-site deadline remains');check(!s.canPlaceSecond(p,true),'armed site cannot be chained with a new second setup');const second=s.take(p,60);check(!!second&&!second.other,'second accepted claim consumes final point');check(s.consumeFallback(p.id),'one fallback payment right');check(!s.consumeFallback(p.id),'cannot consume twice');check(!s.normalClaim(p,101,second,60,350,true),'fallback can never recursively earn');check(s.all(p.id).length===0,'both original sites consumed');
}
{
 const{s,p}=pair(),second={...s.all(p.id)[1]};sync(s,p,270);check(s.all(p.id).length===1,'first original expiry removes only that point');check(JSON.stringify(s.get(p.id))===JSON.stringify(second),'surviving point keeps id/bearing/clock');check(!s.fallback(p,271,true),'expiry does not earn a fallback');const take=s.take(p,271);check(!s.normalClaim(p,200,take,271,0,true),'one surviving site is ordinary Field Rest');
}
{
 const{s,p}=pair();p.x=500;p.aim=0;sync(s,p,50);const take=s.take(p,50);s.normalClaim(p,300,take,50,0,true);s.abandonPaid(p.id);check(!s.released(p,300,51),'cancelled first opportunity never arms');check(s.all(p.id).length===1,'cancelling paid work does not pretend the unclaimed settled site was consumed');p.x=612;p.aim=1;check(!s.fallback(p,52,true),'Clear/damage cancellation invents no right');
}
{
 const{s,p}=pair(),first={...s.all(p.id)[0]};sync(s,p,50,false);check(s.all(p.id).length===1,'capstone loss drops extra position');check(JSON.stringify(s.get(p.id))===JSON.stringify(first),'issued base position remains exact');check(!s.fallback(p,50,false),'no retained capstone credit');p.x=720;check(s.operate(p,51,()=>++id,false,false)==='recall','without capstone B keeps issued recall behavior');check(s.all(p.id).length===0,'no extra site without ownership');
}
{
 const{s,p}=pair();p.x=500;p.aim=0;sync(s,p,50);s.normalClaim(p,400,s.take(p,50),50,0,true);s.released(p,400,51);p.x=800;check(s.operate(p,52,()=>++id,false,true)==='recall','armed B only recalls, even beyond spacing');check(s.all(p.id).length===0&&s.status(p.id).fallbackUntil===0,'recall removes actual site and earned right');
