{
 const s=make(),p=pose(),ally={...pose(),id:'ally'};s.operate(p,0,()=>++id,false,true);sync(s,p,21);check(!s.take(ally,21),'another owner cannot claim this site');s.operate(ally,22,()=>++id,false,true);sync(s,ally,43);s.remove(p.id);check(s.get(ally.id)?.id==='ally','owner loss preserves another owner');s.clear();check(s.owners().length===0,'host/phase clear removes all actual sites');
