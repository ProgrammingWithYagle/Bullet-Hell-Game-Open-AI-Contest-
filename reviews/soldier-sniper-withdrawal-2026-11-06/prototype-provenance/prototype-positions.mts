import fs from'node:fs';import assert from'node:assert/strict';import{SniperPositions}from'./soldier-sniper-positions.mts';
let n=0,id=0;const check=(v:unknown,label:string)=>{assert(v,label);n++;},make=()=>new SniperPositions({settleTicks:21,lifetimeTicks:270,claimRadius:6,aimArc:Math.PI/15,stationaryTolerance:.001},{minimumDistance:96,claimRadius:6,aimArc:Math.PI/15}),pose=()=>({id:'p',x:500,y:500,aim:0,weapon:'rifle',health:100}),sync=(s:SniperPositions,p:ReturnType<typeof pose>,now:number,paired=true)=>s.sync(p,p.id,now,true,true,paired);
