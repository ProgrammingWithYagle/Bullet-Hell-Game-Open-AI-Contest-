import fs from'node:fs';import assert from'node:assert/strict';import{WithdrawalPlan,type Site}from'./withdrawal-plan.mts';let assertions=0;const check=(v:unknown,label:string)=>{assert(v,label);assertions++;},first:Site={owner:'p',id:1,weapon:'rifle',x:500,y:500,aim:0,readyAt:21,until:270},other:Site={owner:'p',id:2,weapon:'rifle',x:600,y:500,aim:1,readyAt:60,until:309},pose={x:600,y:500,aim:1};
{
 const s=new WithdrawalPlan();check(!s.normalClaim('p','rifle',10,first,other,59,0),'both positions must already be settled');check(!s.normalClaim('p','rifle',10,first,other,60,70),'first claim needs normally available C');check(s.normalClaim('p','rifle',10,first,other,60,0),'qualifying actual pair');check(!s.available('p','rifle',other,pose,60,true),'reservation is not a released shot');check(!s.canPlaceSecond('p'),'pending pair cannot be replaced');check(!s.released('p','rifle',10,other,61,false),'failed actual emission preserves pending only');check(!s.released('p','rifle',99,other,61,true),'bind exact preparation');check(s.released('p','rifle',10,other,62,true),'actual first release earns once');check(!s.released('p','rifle',10,other,63,true),'no duplicate release');check(s.available('p','rifle',other,pose,63,true),'actual second site/bearing');check(!s.canPlaceSecond('p'),'armed fallback cannot be replanted into another pair');check(!s.normalClaim('p','rifle',11,first,other,64,0),'old armed right cannot recursively earn');check(!s.consume('p',false),'rejected fallback payment spends nothing');check(s.available('p','rifle',other,pose,65,true),'rejection preserves finite right');check(s.consume('p',true),'one accepted payment');check(!s.consume('p',true),'no repeat payment right');check(!s.available('p','rifle',other,pose,66,true),'consumed site has no credit');check(s.canPlaceSecond('p'),'a genuinely new future pair can be prepared');
}
for(const change of ['owner','weapon','id','expiry','position','bearing','ownership']as const){const s=new WithdrawalPlan();s.normalClaim('p','rifle',20,first,other,60,0);s.released('p','rifle',20,other,61,true);const site={...other},at={...pose};if(change==='owner')site.owner='ally';if(change==='weapon')site.weapon='other';if(change==='id')site.id=3;if(change==='expiry')site.until++;if(change==='position')at.x+=7;if(change==='bearing')at.aim+=.3;check(!s.available('p','rifle',site,at,62,change!=='ownership'),'actual original fallback binding: '+change);}
for(const interruption of ['clear','health','primary','expiry']as const){const s=new WithdrawalPlan();s.normalClaim('p','rifle',30,first,other,60,0);s.abandonPaid('p');check(!s.released('p','rifle',30,other,61,true),'cancellation before actual release earns nothing: '+interruption);check(!s.available('p','rifle',other,pose,62,true),'no invented fallback: '+interruption);}
{
 const s=new WithdrawalPlan();s.normalClaim('p','rifle',40,first,other,60,0);s.released('p','rifle',40,other,61,true);s.abandonPaid('p');check(s.available('p','rifle',other,pose,62,true),'later health loss/new ordinary primary does not erase an already earned settled fallback');check(!s.available('p','rifle',other,pose,309,true),'original expiry never extends');s.sync('p','rifle',other,309,true);check(s.canPlaceSecond('p'),'expired rights clear');
}
{
 const s=new WithdrawalPlan();s.normalClaim('p','rifle',50,first,other,60,0);s.released('p','rifle',50,other,61,true);s.recall('p');check(!s.available('p','rifle',other,pose,62,true),'recall removes rights');s.normalClaim('p','rifle',51,first,other,63,0);s.released('p','rifle',51,other,64,true);s.sync('p','rifle',other,65,false);check(!s.available('p','rifle',other,pose,66,true),'technique loss cannot later resurrect credit');
}
