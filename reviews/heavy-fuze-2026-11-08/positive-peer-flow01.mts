export async function heavyFlakPositivePeerFlow(endpoint:string,handling:FuzeHandling,acquire?:(host:Session,canBuy:boolean,purchase:()=>Promise<void>)=>Promise<unknown>){
 const host=new Session(endpoint),ally=new Session(endpoint),late=new Session(endpoint),purchases:any[]=[],allyPurchases:any[]=[],observed=new Map<number,ObservedRestShot>(),emitted:Shot[]=[],removed=new Set<number>(),otherShots:Shot[]=[],otherRemovals=new Set<number>(),sessions=[host,ally],cues=new Map<Session,Map<number,FlakBurstCue>>([[host,new Map()],[ally,new Map()],[late,new Map()]]);let sequence=0,allySequence=0,lateJoined=false,nonHostRejected=false;
 host.onPurchase=r=>purchases.push(r);ally.onPurchase=r=>allyPurchases.push(r);host.onEvents=events=>{for(const e of events){if(e.type==='shots')for(const s of e.shots){observed.set(s.id,{...s,seenAt:host.view?.combatTick??0});if(s.owner===host.id)emitted.push({...s});}if(e.type==='remove')for(const id of e.ids){removed.add(id);observed.delete(id);}}};for(const s of [ally,late])s.onEvents=events=>{for(const e of events){if(e.type==='shots')otherShots.push(...e.shots);if(e.type==='remove')for(const id of e.ids)otherRemovals.add(id);}};for(const s of [host,ally,late])s.onView=view=>{for(const c of view.classCues)if(c.kind==='heavy-flak-burst')cues.get(s)!.set(c.id,structuredClone(c));};
 const frame=(s:Session,a:object,n:number)=>{const value={...idleInput(),sequence:n,clientTick:s.view?.combatTick??0,aim:0,...a};assert(validInput(value));s.input(value);},p=()=>host.view!.players.find(p=>p.id===host.id)!,join={name:'Native Heavy handling host',classId:'heavy' as const,mode:'raid' as const,difficulty:'baby',seed:41,maxPlayers:4,arenaSelection:'fixed' as const,openingArenaId:'gatehouse'};
 try{
  await host.connect(join);await ally.connect({...join,name:'Ordinary Soldier peer',classId:'soldier'},{roomId:host.room!.roomId});await restWait(()=>!!host.view&&!!ally.view,'ordinary Heavy and Soldier lobbies');
  for(const w of data.weapons.filter(w=>w.classId==='soldier').toSorted((x,y)=>y.tier-x.tier)){const n=allyPurchases.length;ally.purchase({kind:'weapon',item:w.id});await restWait(()=>allyPurchases.length>n&&(!allyPurchases[n].ok||ally.view?.players.find(p=>p.id===ally.id)?.weapon===w.id),'ordinary peer weapon result plus separate view');if(allyPurchases[n].ok)break;}
  const result=await heavyFlakHandlingFlow({
   id:host.id,view:()=>host.view,input:a=>{frame(host,a,++sequence);return sequence;},start:()=>host.start(),vote:index=>{host.vote(index);ally.vote(index);},
   request:async request=>{const n=purchases.length;host.purchase(request);await restWait(()=>{const out=purchases[n];return!!out&&(!out.ok||(request.kind==='skill'?p().skills.includes(request.item):request.kind==='weapon'?p().weapon===request.item:true));},'Heavy owner purchase result plus separate view');return purchases[n];},
   pause:value=>host.setMatchPaused(value),paused:()=>!!host.view?.matchPaused,observedShots:()=>[...observed.values()],emittedShots:()=>emitted,removed:id=>removed.has(id),bursts:()=>[...cues.get(host)!.values()],
   companions:()=>{const v=ally.view,p=v?.players.find(p=>p.id===ally.id);if(v&&p)frame(ally,restRaidInput(v,p,[...observed.values()]),++allySequence);},stopCompanions:()=>frame(ally,{},++allySequence),
   acquireHandling:acquire?(canBuy,purchase)=>acquire(host,canBuy,purchase):undefined,
   checkPausedObservers:async()=>{await restWait(()=>!!ally.view?.matchPaused,'actual shared Heavy carrier pause');const tick=host.view!.combatTick;ally.room!.send('pauseMatch',false);ally.room!.send('endMatch');await late.connect({...join,name:'Late medic observer',classId:'medic'},{roomId:host.room!.roomId});sessions.push(late);lateJoined=true;await restWait(()=>!!late.view?.matchPaused,'late observer sees actual paused carrier clock');await new Promise(r=>setTimeout(r,60));assert(host.view!.matchPaused&&host.view!.phase==='combat');assert.equal(host.view!.combatTick,tick);assert.equal(late.view!.players.find(p=>p.id===late.id)!.skills.length,0);for(const key of ['heavyFlakX','heavyFlakY','quota','pending'])assert(!Object.hasOwn(late.view!.players.find(p=>p.id===host.id)!.kit,key));nonHostRejected=true;},
   checkSharedBurst:async cue=>{await restWait(()=>sessions.every(s=>cues.get(s)!.has(cue.id)),'finite Heavy burst/contact geometry reaches actual peers');for(const s of sessions)assert.deepEqual(cues.get(s)!.get(cue.id),cue);},
   checkOwnerStreams:id=>{assert(!otherShots.some(s=>s.owner===host.id),'initial flight and same-id stop updates remain owner-only');assert(!otherRemovals.has(id),'actual friendly carrier removal remains owner-only');}
  },handling,handling==='hanging'?'frontal':'compact');
  const positive=await positiveFlakWitness({endpoint,host,ally,sessions,cues,observed:()=>[...observed.values()],emitted:()=>emitted,removed:(id:number)=>removed.has(id),input:(a:object)=>frame(host,a,++sequence),companion:()=>{const v=ally.view,p=v?.players.find(p=>p.id===ally.id);if(v&&p)frame(ally,{...restRaidInput(v,p,[...observed.values()]),fire:false,q:false,ultimate:false},++allySequence);}},handling);
  // An additional actual paid carrier proves host exit after the acquired operation; it is separate from the first one-round witness.
  const deadline=Date.now()+20000;while((p().kit.technique1At??0)>host.view!.combatTick||p().kit.heavyFlakBlocked){assert(Date.now()<deadline&&host.view!.phase==='combat','original Heavy recovery before a separate host-exit carrier');const action=restRaidInput(host.view!,p(),[...observed.values()]);frame(host,{...action,fire:false,q:false,e:false,ultimate:false},++sequence);await new Promise(r=>setTimeout(r,25));}
  const aim=heavyOpenLane(host.view!,host.id).aim,known=new Set(emitted.filter(s=>s.visual==='flak').map(s=>s.id)),exitAmmo=p().ammo;frame(host,{aim,technique1:true},++sequence);await restWait(()=>emitted.some(s=>s.visual==='flak'&&!known.has(s.id))&&(p().kit.heavyFlakUntil??0)>0,'separate actual paid host-exit carrier');const exitShot=emitted.find(s=>s.visual==='flak'&&!known.has(s.id))!;
  if(handling==='hanging'){frame(host,{aim,technique2:true},++sequence);await restWait(()=>emitted.some(s=>s.id===exitShot.id&&s.vx===0&&s.vy===0),'actual second arrested carrier before host exit');}
  host.setMatchPaused(true);await restWait(()=>!!host.view?.matchPaused,'freeze the actual host-exit carrier');assert.equal(p().ammo,exitAmmo-1);assert(!removed.has(exitShot.id));host.endMatch();await restWait(()=>sessions.every(s=>s.view?.phase==='defeat'&&s.view.endedByHost)&&removed.has(exitShot.id),'host exit removes actual live carrier and owner removal');assert(!otherShots.some(s=>s.owner===host.id));assert(!otherRemovals.has(exitShot.id));
  return{...result,positiveInterceptionWitness:positive,ownerOnlyFriendlyStreamsAndStoppedUpdates:true,ownerOnlyFriendlyRemovals:true,sharedFiniteActualBurstGeometry:true,lateObserverWithoutOwnership:lateJoined,nonHostPauseAndEndRejected:nonHostRejected,hostExitRemovesAdditionalActualCarrier:true,hostExitCarrierId:exitShot.id,hostExitCarrierPaysSeparateActualRound:true,noCheckpointUploaded:true,firstCarrierRoundSpentOnce:true};
 }finally{host.close();ally.close();late.close();}
