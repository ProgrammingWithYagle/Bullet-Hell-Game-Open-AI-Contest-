-            "text": "Finish the evacuation before arguing with another form.",
-            "arenaId": "triage-yard"
-          },
-          {
-            "title": "Trace every blank entry",
-            "text": "Ask each witness who should have occupied the missing line.",
-            "arenaId": "crown-crypt"
