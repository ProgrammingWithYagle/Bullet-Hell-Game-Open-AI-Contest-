import test from'node:test';import assert from'node:assert/strict';
import{HeavyClutchHandlingCandidate as Candidate,traverseIds as ids,clutchId,keyedId,openId,type TraverseContext}from'./handling-candidate01.mts';
import{idleInput,type Shot}from'../../../../../../OneDrive/Documents/ChatGPT/OpenAI Multiplayer Game Contest (Bullet Hell)/src/shared/protocol.ts';
function fixture(mode:'loose'|'spade'|'floating'='loose',handling?:string){
 const p:any={id:'owner',classId:'heavy',skills:[ids.entry,clutchId,...(mode==='loose'?[]:[ids[mode]]),...(handling?[handling]:[])],connected:true,status:'active',health:140,weapon:'heavy-0',ammo:45,aim:0,x:600,y:600,reloadAt:0,dashUntil:0,channelUntil:0,overdriveUntil:0,input:idleInput()},c:TraverseContext={tick:0,stats:()=>({damage:1,cooldown:1}),canEmit:()=>true,shoot:(owner,aim,damage,speed,radius,life)=>{const shot:Shot={id:++serial,owner:owner.id,x:owner.x,y:owner.y,vx:Math.cos(aim)*speed,vy:Math.sin(aim)*speed,radius,damage,pierce:0,expires:c.tick+30*life};shots.set(shot.id,shot);emitted.push({...shot,at:c.tick});return shot;},sound:()=>{}},controller=new Candidate(),shots=new Map<number,Shot>(),emitted:any[]=[];let serial=0,sequence=0;
 const authority=()=>({tick:c.tick,players:[p],shot:(id:number)=>shots.get(id),remove:(s:Shot)=>{shots.delete(s.id);controller.forget(s.id);}}),step=(input:any={})=>{c.tick++;p.input={...idleInput(),sequence:++sequence,aim:0,...input};p.aim=p.input.aim;controller.beforeMove(p,c);if(p.input.technique1)controller.cast(p,c);controller.advance(p,c);controller.reconcile(authority());};return{p,c,controller,shots,emitted,step,authority,status:()=>controller.status(p,c.tick)};
}
test('Keyed uses a bounded lifted crank on every carriage, then retains the actual re-engagement bearing through different mouse aim',()=>{
 for(const mode of['loose','spade','floating']as const){const f=fixture(mode,keyedId);f.step({technique1:true});f.step({technique2:true});for(let n=3;n<=6;n++)f.step({aim:0.6});const bearing=f.status().heavyTraverseAim;assert(bearing>0&&bearing<0.6);f.step({technique2:true,aim:-0.6});for(let n=8;n<=31;n++)f.step({aim:-0.6});assert.deepEqual(f.emitted.map(s=>s.at),[1,11,21,31]);assert(f.emitted.slice(1).every(s=>Math.abs(Math.atan2(s.vy,s.vx)-bearing)<1e-6));assert.equal(f.p.ammo,41);assert.equal(f.status().technique1At,241);}
});
test('standard lifted Floating retains its birth bearing and standard Loose retains steering after re-engagement',()=>{
 const floating=fixture('floating');floating.step({technique1:true});floating.step({technique2:true});for(let n=3;n<=6;n++)floating.step({aim:0.6});assert.equal(floating.status().heavyTraverseAim,0);const loose=fixture();loose.step({technique1:true});loose.step({technique2:true});loose.step({technique2:true});for(let n=4;n<=11;n++)loose.step({aim:0.6});assert(loose.emitted[1].vy>0);
});
test('Open permits ordinary fire only during the lifted window and converts the earliest future original opportunity',()=>{
 const f=fixture('loose',openId);f.step({technique1:true});assert(f.controller.blocksPrimary(f.p.id,1));f.step({technique2:true});assert(!f.controller.blocksPrimary(f.p.id,2));assert(f.controller.primaryRound(f.p,f.c));assert.equal(f.status().heavyClutchConverted,1);assert.equal(f.status().heavyTraverseNextAt,21);f.step({technique2:true});assert(f.controller.blocksPrimary(f.p.id,3));assert(!f.controller.primaryRound(f.p,f.c));while(f.c.tick<31)f.step();assert.deepEqual(f.emitted.map(s=>s.at),[1,21,31]);assert.equal(f.p.ammo,42);assert.equal(f.status().technique1At,241);
});
test('a converted opportunity cannot also pass unpaid, and later original slots remain exactly scheduled',()=>{
 const f=fixture('spade',openId);f.step({technique1:true});f.step({technique2:true});assert(f.controller.primaryRound(f.p,f.c));while(f.c.tick<11)f.step();assert.equal(f.status().heavyClutchForfeited,1);assert.equal(f.status().heavyClutchConverted,1);while(f.c.tick<21)f.step();assert.equal(f.status().heavyClutchForfeited,2);f.step({technique2:true});while(f.c.tick<31)f.step();assert.deepEqual(f.emitted.map(s=>s.at),[1,31]);assert.equal(f.p.ammo,43);assert.equal(f.status().technique1At,241);
});
test('three actual-round callbacks in one combat step consume three different original opportunities without a per-tick deduplication',()=>{
 const f=fixture('floating',openId);f.step({technique1:true});f.step({technique2:true});for(let n=0;n<3;n++)assert(f.controller.primaryRound(f.p,f.c));assert(!f.controller.primaryRound(f.p,f.c));assert.equal(f.status().heavyTraverseUntil,0);assert.equal(f.p.ammo,44);while(f.c.tick<40)f.step();assert.equal(f.emitted.length,1);assert.equal(f.status().technique1At,241);
});
test('handling ownership is captured for used retained work and later C flights without retroactively changing the earlier base round',()=>{
 for(const handling of[keyedId,openId]){const f=fixture('floating',handling);f.step({technique1:true});const base=f.emitted[0].id;f.step({technique2:true});f.step({technique2:true});while(f.c.tick<11)f.step();const later=f.emitted[1].id;f.p.skills=f.p.skills.filter((id:string)=>id!==handling);f.controller.reconcile(f.authority());assert(f.shots.has(base));assert(!f.shots.has(later));assert.equal(f.status().heavyTraverseUntil,0);assert.equal(f.status().technique1At,241);assert.equal(f.status().heavyTraverseShotAt,0);}
});
test('unowned and busy primary conversion callbacks cannot consume retained C opportunities',()=>{
 const ordinary=fixture();ordinary.step({technique1:true});ordinary.step({technique2:true});assert(!ordinary.controller.primaryRound(ordinary.p,ordinary.c));assert.equal(ordinary.status().heavyTraverseNextAt,11);const f=fixture('loose',openId);f.step({technique1:true});f.step({technique2:true});f.p.reloadAt=100;assert(!f.controller.primaryRound(f.p,f.c));f.controller.reconcile(f.authority());assert.equal(f.status().heavyTraverseUntil,0);assert.equal(f.p.ammo,44);assert.equal(f.status().technique1At,241);
});
