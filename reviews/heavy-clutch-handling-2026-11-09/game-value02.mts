import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{fileURLToPath,pathToFileURL}from'node:url';import{traverseIds as ids,clutchId,keyedId,openId,heavyTraverseRules as r}from'./handling-candidate01.mts';import{idleInput}from'../../../../../../OneDrive/Documents/ChatGPT/OpenAI Multiplayer Game Contest (Bullet Hell)/src/shared/protocol.ts';
const stage=path.dirname(fileURLToPath(import.meta.url)),{Game}=await import(pathToFileURL(stage+'/game-study02.mjs').href),report:any={checkedAt:new Date().toISOString(),registered:false,canonicalFilesWritten:false,onlineProof:false,countsAs2093Tests:false,controlledProposedOwnershipOnly:true,binding:JSON.parse(fs.readFileSync(stage+'/game-study02-binding.json','utf8')),cases:[]};
function fixture(mode:'loose'|'spade'|'floating'='loose',handling?:string){const g:any=new Game({mode:'raid',seed:41,maxPlayers:2,arenaSelection:'fixed',openingArenaId:'gatehouse'}),p=g.addPlayer('owner','Hux','heavy'),ally=g.addPlayer('ally','Mara','soldier');for(const item of['heavy-ordnance-1',ids.entry,...(mode==='loose'?[]:[ids[mode]]),clutchId])assert(g.transact(p.id,{id:item,kind:'skill',item}).ok);if(handling)p.skills.push(handling);assert(g.start());g.boss.id='constable';g.director.reset('constable');Object.assign(g.boss,{x:1200,y:200,health:1e6,maxHealth:1e6,staggerUntil:1e9,deadline:1e9});Object.defineProperty(g,'arena',{value:structuredClone(g.arena)});g.arena.obstacles.length=g.arena.lavaPits.length=0;Object.assign(p,{x:600,y:600,oldX:600,oldY:600});Object.assign(ally,{x:1400,y:900,oldX:1400,oldY:900});g.drainEvents();let sequence=0;const shots:any[]=[],conversions:any[]=[],original=g.traverse.primaryRound.bind(g.traverse);g.traverse.primaryRound=(owner:any,c:any)=>{const before=g.traverse.status(owner,c.tick),ok=original(owner,c);if(ok)conversions.push({tick:c.tick,actualAmmo:owner.ammo,beforeNext:before.heavyTraverseNextAt,afterNext:g.traverse.status(owner,c.tick).heavyTraverseNextAt});return ok;};const step=(input:any={})=>{assert(g.submitInput(p.id,{...idleInput(),sequence:++sequence,aim:0,...input}));g.step();for(const e of g.drainEvents())if(e.type==='shots')shots.push(...e.shots.filter((s:any)=>s.owner===p.id).map((s:any)=>({...s,at:g.combatTick})));},target=(x:number,y:number)=>g.spawnMinion({kind:'ordinary',x,y,health:1000,speed:0,radius:16,damage:0})!,status=()=>g.traverse.status(p,g.combatTick),special=()=>shots.filter(s=>Math.abs(Math.hypot(s.vx,s.vy)-r.speed)<1e-6);return{g,p,ally,step,target,status,shots,special,conversions};}
function check(name:string,fn:()=>unknown){try{report.cases.push({name,passed:true,details:fn()});}catch(e:any){report.cases.push({name,passed:false,error:e.stack});}}
check('Keyed decouples a real original-slot C emission from an oppositely aimed real Q without adding a round or Q cast',()=>{const rows=[];for(const mode of['loose','spade','floating']as const)for(const handling of[undefined,keyedId]){const f=fixture(mode,handling),east=f.target(900,600),west=f.target(400,600);f.step({technique1:true});f.step({technique2:true});f.step({technique2:true});for(let t=4;t<=60;t++)f.step({aim:t>=11?Math.PI:0,q:t===11});const row={mode,handling:handling??'standard',Cslots:f.special().map(s=>s.at),eastDamage:1000-east.health,westDamage:1000-west.health,actualPaidRounds:45-f.p.ammo,qRecovery:f.p.qAt,CRecovery:f.status().technique1At};assert.deepEqual(row.Cslots,[1,11,21,31]);assert.equal(row.actualPaidRounds,4);assert(row.westDamage>0);if(handling===keyedId||mode==='floating')assert(Math.abs(row.eastDamage-194.4)<1e-6);else assert(Math.abs(row.eastDamage-48.6)<1e-6);rows.push(row);}return rows;});
check('Keyed gives up real later manual retargeting that standard Loose and Spade retain',()=>{const rows=[];for(const mode of['loose','spade']as const)for(const handling of[undefined,keyedId]){const f=fixture(mode,handling),east=f.target(900,600),north=f.target(900,600+Math.tan(0.6)*300);f.step({technique1:true});f.step({technique2:true});f.step({technique2:true});for(let t=4;t<=60;t++)f.step({aim:0.6});const damage=1000-north.health;if(handling===keyedId)assert.equal(damage,0);else assert(Math.abs(damage-145.8)<1e-6);rows.push({mode,handling:handling??'standard',laterTargetDamage:damage,firstLaneDamage:1000-east.health,rounds:45-f.p.ammo});}return rows;});
check('Floating Keyed uses a real bounded calibration window, losing an original slot to redirect two later actual rounds',()=>{const rows=[];for(const handling of[undefined,keyedId]){const f=fixture('floating',handling),east=f.target(900,600),north=f.target(900,600+Math.tan(0.6)*300);f.step({technique1:true});f.step({technique2:true});for(let t=3;t<=11;t++)f.step({aim:0.6});f.step({technique2:true,aim:0.6});for(let t=13;t<=60;t++)f.step({aim:-0.6});const damage=1000-north.health;assert.deepEqual(f.special().map(s=>s.at),[1,21,31]);if(handling===keyedId)assert(Math.abs(damage-97.2)<1e-6);else assert.equal(damage,0);rows.push({handling:handling??'standard',newLaneDamage:damage,firstLaneDamage:1000-east.health,paidRounds:45-f.p.ammo,Cslots:f.special().map(s=>s.at)});}return rows;});
check('Open converts one actual paid primary round into the earliest future C opportunity, preserving the original remaining slots on all carriages',()=>{const rows=[];for(const mode of['loose','spade','floating']as const){const f=fixture(mode,openId),target=f.target(900,600);f.step({technique1:true});f.step({technique2:true,fire:true});assert.equal(f.status().heavyClutchConverted,1);assert.equal(f.status().heavyTraverseNextAt,21);assert.equal(f.p.ammo,43);f.step({technique2:true});for(let t=4;t<=60;t++)f.step();assert.deepEqual(f.special().map(s=>s.at),[1,21,31]);const primary=f.shots.filter(s=>!f.special().some(c=>c.id===s.id));assert.equal(primary.length,1);assert.equal(primary[0].at,2);assert.equal(f.conversions.length,1);assert.equal(45-f.p.ammo,4);assert(Math.abs((1000-target.health)-f.shots.reduce((n,s)=>n+s.damage,0))<1e-6);assert(1000-target.health<194.4);rows.push({mode,actualCslots:[1,21,31],actualPrimaryAt:2,actualTargetDamage:1000-target.health,actualPaidRounds:4,conversions:f.conversions,originalRecovery:f.status().technique1At});}return rows;});
check('Open preflights the complete actual primary volley; a rejected full or partial capacity spends no ammo/cadence/slot, and three pellets convert once',()=>{const f=fixture('spade',openId);f.step({technique1:true});const original=f.g.stats.bind(f.g);f.g.stats=(p:any)=>({...original(p),...(p.id===f.p.id?{extraShots:2}:{})});const fillers:any[]=[];while(f.g.shots.size<6000)fillers.push(f.g.emitShot(f.ally.id,1400,900,0,0,1,1,0,10));f.step({technique2:true,fire:true});assert.equal(f.p.ammo,44);assert.equal(f.conversions.length,0);assert.equal(f.status().heavyTraverseNextAt,11);const rejectedFireAt=f.p.fireAt;assert.equal(rejectedFireAt,2);f.g.removeShot(fillers.pop());f.step({fire:true});assert.equal(f.p.fireAt,rejectedFireAt);assert.equal(f.p.ammo,44);assert.equal(f.conversions.length,0);f.g.removeShot(fillers.pop());f.g.removeShot(fillers.pop());f.step({fire:true});const primary=f.shots.filter(s=>s.at===4);assert.equal(primary.length,3);assert.equal(f.p.ammo,43);assert.equal(f.conversions.length,1);assert.equal(f.status().heavyClutchConverted,1);assert.equal(f.status().heavyTraverseNextAt,21);return{controlledExtraPellets:2,actualPellets:3,actualPrimaryRounds:1,remainingPool:f.g.shots.size,actualAmmo:43,conversions:f.conversions};});
check('three actual Game primary rounds in one controlled held-fire debt step consume three distinct original opportunities',()=>{const f=fixture('spade',openId);f.step({technique1:true});f.p.wasFiring=true;f.p.fireAt=-20;f.step({technique2:true,fire:true});const primary=f.shots.filter(s=>s.at===2);assert.equal(primary.length,3);assert.equal(f.conversions.length,3);assert.equal(f.p.ammo,41);assert.equal(f.status().heavyTraverseUntil,0);assert.equal(f.status().technique1At,241);return{controlledHeldFireDebt:true,actualPrimaryRounds:3,allAtTick:2,actualAmmoSpent:4,conversions:f.conversions};});
report.passed=report.cases.every((c:any)=>c.passed);report.passedCount=report.cases.filter((c:any)=>c.passed).length;report.failedCount=report.cases.length-report.passedCount;fs.writeFileSync(path.resolve(stage,'../../outputs/Heavy-clutch-handling-game-value02.json'),JSON.stringify(report,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(report));if(!report.passed)process.exitCode=1;
