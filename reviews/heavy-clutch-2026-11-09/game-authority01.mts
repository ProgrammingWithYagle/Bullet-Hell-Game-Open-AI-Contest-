import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{fileURLToPath}from'node:url';import{Game}from'./game-study01.mjs';import{traverseIds as ids,clutchId}from'./clutch-candidate01.mts';import{idleInput}from'../../../../../../OneDrive/Documents/ChatGPT/OpenAI Multiplayer Game Contest (Bullet Hell)/src/shared/protocol.ts';
const stage=path.dirname(fileURLToPath(import.meta.url)),report:any={checkedAt:new Date().toISOString(),registered:false,canonicalFilesWritten:false,onlineProof:false,countsAs2044Tests:false,controlledPrototypeOwnershipOnly:true,sourceBinding:JSON.parse(fs.readFileSync(stage+'/game-study01-binding.json','utf8')),cases:[]};
function fixture(mode:'loose'|'spade'|'floating'='loose'){
 const g:any=new Game({mode:'raid',seed:41,maxPlayers:2,arenaSelection:'fixed',openingArenaId:'gatehouse'}),p=g.addPlayer('owner','Hux','heavy'),ally=g.addPlayer('ally','Mara','soldier');for(const item of['heavy-ordnance-1',ids.entry,...(mode==='loose'?[]:[ids[mode]])])assert(g.transact(p.id,{id:item,kind:'skill',item}).ok);p.skills.push(clutchId);assert(g.start());g.boss.id='constable';g.director.reset('constable');Object.assign(g.boss,{x:1200,y:200,health:1e6,maxHealth:1e6,staggerUntil:1e9,deadline:1e9});Object.defineProperty(g,'arena',{value:structuredClone(g.arena)});g.arena.obstacles.length=g.arena.lavaPits.length=0;Object.assign(p,{x:600,y:600,oldX:600,oldY:600});Object.assign(ally,{x:1400,y:900,oldX:1400,oldY:900});g.drainEvents();let sequence=0;const emitted:any[]=[],events:any[]=[];
 const step=(input:any={})=>{assert(g.submitInput(p.id,{...idleInput(),sequence:++sequence,aim:0,...input}));g.step();for(const e of g.drainEvents()){events.push(e);if(e.type==='shots')emitted.push(...e.shots.filter((s:any)=>s.owner===p.id).map((s:any)=>({...s})));}};return{g,p,ally,step,emitted,events,status:()=>g.traverse.status(p,g.combatTick),flights:()=>[...g.shots.values()].filter((s:any)=>g.traverse.has(s.id))};
}
function check(name:string,fn:()=>unknown){try{report.cases.push({name,passed:true,details:fn()});}catch(e:any){report.cases.push({name,passed:false,error:e.stack});}}
check('actual source movement releases lifted walking immediately and real Braced Firing still applies its independent60percent speed',()=>{const f=fixture('spade');f.step({technique1:true,e:true});f.step({technique2:true,moveY:1});assert(Math.abs(f.p.y-603.8)<1e-6);assert.equal(f.p.braceUntil,151);assert.equal(f.status().heavyClutchLifted,true);assert.equal(f.p.ammo,44);assert.equal(f.status().technique1At,241);return{actualY:f.p.y,braceUntil:f.p.braceUntil,recovery:241};});
check('actual reload, dodge and ultimate stop lifted future work while retaining paid flights and their original recovery',()=>{const rows=[];for(const key of['reload','dodge','ultimate']){const f=fixture();f.step({technique1:true});const id=f.flights()[0].id;f.step({technique2:true});f.step({[key]:true});assert.equal(f.status().heavyTraverseUntil,0);assert.equal(f.status().technique1At,241);assert.equal(f.p.ammo,44);assert(f.g.shots.has(id));rows.push({key,paidShotStillActual:true,recovery:241,reloadAt:f.p.reloadAt,dashUntil:f.p.dashUntil,overdriveUntil:f.p.overdriveUntil});}return rows;});
check('actual early channel return cancels the lifted feed without refund or a delayed catch-up',()=>{const f=fixture();f.step({technique1:true});f.step({technique2:true});f.p.channelUntil=100;f.step();assert.equal(f.status().heavyTraverseUntil,0);assert.equal(f.p.ammo,44);assert.equal(f.status().technique1At,241);assert.equal(f.flights().length,1);return{channelUntil:f.p.channelUntil,paidFlights:1,recovery:241};});
check('actual operation loss removes only dependent later flights and keeps the earlier base round without refund',()=>{const f=fixture('floating');f.step({technique1:true});const earlier=f.flights()[0].id;f.step({technique2:true});f.step({technique2:true});while(f.g.combatTick<12)f.step();assert.equal(f.flights().length,2);const later=f.flights().find((s:any)=>s.id!==earlier)!.id;f.p.skills=f.p.skills.filter((id:string)=>id!==clutchId);f.step();assert(f.g.shots.has(earlier));assert(!f.g.shots.has(later));assert.equal(f.status().heavyTraverseUntil,0);assert.equal(f.p.ammo,43);assert.equal(f.status().technique1At,241);assert.equal(f.status().heavyTraverseShotAt,0);return{earlierRetained:earlier,laterRemoved:later,recovery:241};});
check('actual full pool ends a re-engaged unpaid slot with no extra round, deferred shot or recovery reset',()=>{const f=fixture();f.step({technique1:true});f.step({technique2:true});f.step({technique2:true});while(f.g.shots.size<6000)assert(f.g.emitShot(f.ally.id,1400,900,0,0,0,1,0,10));while(f.g.combatTick<11)f.step();assert.equal(f.status().heavyTraverseUntil,0);assert.equal(f.p.ammo,44);assert.equal(f.status().technique1At,241);assert.equal(f.emitted.length,1);return{pool:f.g.shots.size,actualRounds:1,recovery:241};});
check('actual host exit removes lifted C flight, while actual pooled reuse cannot redirect owner cancellation to another player',()=>{const first=fixture();first.step({technique1:true});first.step({technique2:true});const id=first.flights()[0].id;assert(first.g.endByHost());assert(!first.g.shots.has(id));assert.equal(first.status().heavyTraverseUntil,0);const second=fixture();second.step({technique1:true});const old=second.flights()[0],oldId=old.id;second.g.removeShot(old);const reused=second.g.emitShot(second.ally.id,1400,900,0,0,0,1,0,10);assert.equal(reused,old);assert.notEqual(reused.id,oldId);second.g.setConnected(second.p.id,false);assert.equal(second.g.shots.get(reused.id),reused);assert.equal(second.status().technique1At,241);return{hostRemovedActual:id,reusedActualId:reused.id,foreignOwner:reused.owner,recovery:241};});
report.passed=report.cases.every((c:any)=>c.passed);report.passedCount=report.cases.filter((c:any)=>c.passed).length;report.failedCount=report.cases.length-report.passedCount;fs.writeFileSync(path.resolve(stage,'../../outputs/Heavy-clutch-game-authority01.json'),JSON.stringify(report,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(report));if(!report.passed)process.exitCode=1;
