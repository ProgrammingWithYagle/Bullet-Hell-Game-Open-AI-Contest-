diff --git a/tests/porch-watch.test.ts b/tests/porch-watch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..17e9b62bdf883f91e3d5326dd98f78d47df1232a
--- /dev/null
+++ b/tests/porch-watch.test.ts
@@ -0,0 +1,75 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import catalog from '../content/catalog.json';
+import { HZ } from '../src/shared/protocol.ts';
+import { PorchWatch, porchHoldPoint, type PorchWatchContext } from '../src/shared/porch-watch.ts';
+import rules from '../src/shared/porch-watch-rules.json';
+import { Minions } from '../src/shared/minions.ts';
+import { runtimeArena } from '../src/shared/arena-layouts.ts';
+import { distance, segmentRect } from '../src/shared/geometry.ts';
+function fixture(party=1){
+ const minions=new Minions(),watch=new PorchWatch(),body={x:300,y:300};
+ let nextId=1;
+ const c:PorchWatchContext={now:0,bounds:{x:100,y:100,width:1000,height:700},obstacles:[],lava:[],targets:[body],holders:[],actors:minions.actors,healthScale:1,damageScale:1,speedScale:1,spawn:def=>minions.spawn(nextId++,def,c.now)};
+ watch.start(0,party);
+ const step=(n=1)=>{for(let i=0;i<n;i++){c.now++;watch.step(c);}};
+ step();
+ return {watch,c,minions,body,step};
+}
+test('Hold progress requires a real supplied player body and clear ground; targets alone, contested edges, repeated ticks and clock jumps cannot manufacture held time',()=>{
+ const {watch,c,body,step}=fixture(),hold=watch.view().hold!;
+ Object.assign(body,hold);c.targets=[body];step(50);
+ assert.equal(watch.view().heldTicks,0,'A pet/decoy aim target cannot hold');
+ c.holders=[body];step();assert.equal(watch.view().heldTicks,1);
+ watch.step(c);assert.equal(watch.view().heldTicks,1);
+ c.now+=200;watch.step(c);assert.equal(watch.view().heldTicks,2);
+ const enemy={id:9900,kind:'ordinary' as const,x:hold.x+hold.radius+11,y:hold.y,oldX:0,oldY:0,health:20,maxHealth:20,speed:0,radius:12,damage:0,expires:100000,attackAt:0,slowUntil:0,slowMultiplier:1};
+ c.actors.set(enemy.id,enemy);step(20);
+ assert.equal(watch.view().heldTicks,2);assert.equal(watch.view().contesting,1);
+ enemy.x=hold.x+hold.radius+13;step();assert.equal(watch.view().heldTicks,3);
+ body.x=hold.x+hold.radius-catalog.rules.playerRadius+1;step();assert.equal(watch.view().heldTicks,3);
+});
+test('Sixty seconds of actual uncontested occupancy completes with surviving enemies and no fabricated defeats, while an empty hold fails at its deadline',()=>{
+ const {watch,c,body,step}=fixture(),hold=watch.view().hold!;
+ Object.assign(body,hold);c.targets=[body];c.holders=[body];
+ step(rules.holdSeconds*HZ-1);assert.equal(watch.view().status,'complete');
+ const state=watch.view();assert.equal(state.heldTicks,state.requiredHoldTicks);
+ assert.equal(state.defeated,0);assert.equal(state.remaining,state.total);assert(c.actors.size>0);
+ assert.equal(state.wave,3);assert.equal(state.portals.length,0);
+ const prior=JSON.stringify(state);step(300);assert.equal(JSON.stringify(watch.view()),prior);
+ const failed=fixture();failed.step(rules.deadlineSeconds*HZ);
+ assert.equal(failed.watch.view().status,'failed');assert.equal(failed.watch.view().heldTicks,0);assert.equal(failed.watch.view().portals.length,0);
+});
+test('Wave warnings keep their promised positions, occupied landings receive a new full warning, and cancelled ownership never spawns late actors',()=>{
+ const {watch,c,step}=fixture(),promised=watch.view().portals;
+ assert(promised.length>0);const at=promised[0].at;
+ const copied=watch.view();copied.portals[0].x=-999;assert.notEqual(watch.view().portals[0].x,-999);
+ c.targets=promised.map(({x,y})=>({x,y}));
+ step(at-c.now-1);assert.equal(c.actors.size,0);
+ step();assert.equal(c.actors.size,0);assert.equal(watch.view().portals.length,0);
+ step(rules.retryTicks);const fresh=watch.view().portals;
+ assert(fresh.length>0);assert(fresh.every(p=>p.at===c.now+Math.ceil(rules.warningSeconds*HZ)));
+ const before=c.actors.size;watch.cancel();step(200);
+ assert.equal(c.actors.size,before);assert.equal(watch.view().portals.length,0);
+});
+test('A fifty-player plan remains bounded at fifty real actors and only actual removed bodies count as defeats',()=>{
+ const {watch,c,minions,step}=fixture(50);
+ step(50*HZ);assert(c.actors.size<=rules.maximumLive);assert.equal(watch.view().total,72);
+ assert.equal(watch.view().defeated,0);
+ const ids=[...c.actors.keys()].slice(0,3);assert.equal(ids.length,3);
+ for(const id of ids)assert(minions.hit(id,1e6,c.now)>0);
+ step();assert.equal(watch.view().defeated,3);assert.equal(watch.view().remaining,69);
+ step(5*HZ);assert(c.actors.size<=rules.maximumLive);
+});
+test('Each of the three hold approaches fits complete visible ground on every map and difficulty, outside current cover and all lava footprints',()=>{
+ for(const map of catalog.arenas)for(const difficulty of catalog.difficulties)for(let route=0;route<3;route++){
+  const arena=runtimeArena(map.id,difficulty.id),point=porchHoldPoint(arena.bounds,arena.obstacles,arena.lavaPits,route);
+  assert(point,map.id+'/'+difficulty.id+'/'+route);
+  assert(point.radius>=rules.minimumHoldRadius);
+  assert(!arena.obstacles.some(w=>segmentRect(point,point,w,point.radius+4)));
+  assert(arena.lavaPits.every(p=>distance(point,p)>=point.radius+p.radius+8));
+  assert(point.x-point.radius>=arena.bounds.x&&point.x+point.radius<=arena.bounds.x+arena.bounds.width);
+  assert(point.y-point.radius>=arena.bounds.y&&point.y+point.radius<=arena.bounds.y+arena.bounds.height);
+ }
+ assert.equal(porchHoldPoint({x:0,y:0,width:10,height:10},[],[]),undefined);
+});
