+++ b/src/shared/porch-watch.ts
@@ -0,0 +1,116 @@
+import catalog from '../../content/catalog.json';
+import rules from './porch-watch-rules.json';
+import { HZ, type Vec } from './protocol.ts';
+import { distance, segmentRect, type Rect } from './geometry.ts';
+import { skirmishSites, type WardSkirmishContext } from './ward-skirmish.ts';
+export type PorchWatchView = {
+  id: 'porch-watch';
+  status: 'briefing' | 'warning' | 'fighting' | 'complete' | 'failed';
+  wave: number;
+  waves: number;
+  defeated: number;
+  total: number;
+  remaining: number;
+  deadline: number;
+  portals: (Vec & {at:number})[];
+  hold?: Vec & {radius:number};
+  heldTicks: number;
+  requiredHoldTicks: number;
+  holding: number;
+  contesting: number;
+};
+export type PorchWatchContext = WardSkirmishContext & {
+  /** Actual connected active players only. Pets and decoys must not hold ground. */
+  holders: readonly Vec[];
+};
+const ticks=(seconds:number)=>Math.ceil(seconds*HZ);
+const scale=(value:number)=>Number.isFinite(value)?Math.max(.05,Math.min(10,value)):1;
+/** A full visible circle fits actual floor, cover and every authored lava footprint. */
+export function porchHoldPoint(bounds:Rect,obstacles:readonly Rect[],lava:readonly(Vec&{radius:number})[],route=0){
+  if(![bounds.x,bounds.y,bounds.width,bounds.height].every(Number.isFinite)||bounds.width<=0||bounds.height<=0)return;
+  const fraction=[.28,.5,.72][Number.isSafeInteger(route)&&route>=0&&route<=2?route:0];
+  const preferred={x:bounds.x+bounds.width*fraction,y:bounds.y+bounds.height*.55};
+  for(let radius=rules.holdRadius;radius>=rules.minimumHoldRadius;radius-=8){
+    const candidates:Vec[]=[preferred];
+    for(let y=bounds.y+radius+8;y<=bounds.y+bounds.height-radius-8;y+=32)
+      for(let x=bounds.x+radius+8;x<=bounds.x+bounds.width-radius-8;x+=32)candidates.push({x,y});
+    const point=candidates.filter(p=>p.x-radius>=bounds.x+4&&p.x+radius<=bounds.x+bounds.width-4&&p.y-radius>=bounds.y+4&&p.y+radius<=bounds.y+bounds.height-4&&!obstacles.some(w=>segmentRect(p,p,w,radius+4))&&!lava.some(pit=>distance(p,pit)<radius+pit.radius+8))
+      .toSorted((a,b)=>distance(a,preferred)-distance(b,preferred)||a.y-b.y||a.x-b.x)[0];
+    if(point)return {...point,radius};
+  }
+}
+/** Timed space control. Success never implies every planned enemy was killed. */
+export class PorchWatch {
+  private state:PorchWatchView={
+    id:'porch-watch',status:'briefing',wave:0,waves:rules.waveCounts.length,
+    defeated:0,total:0,remaining:0,deadline:0,portals:[],
+    heldTicks:0,requiredHoldTicks:ticks(rules.holdSeconds),holding:0,contesting:0,
+  };
+  private began=0;
+  private lastTick=-1;
+  private stopped=true;
+  private counts:number[]=[];
+  private queue:{wave:number;count:number}[]=[];
+  private alive=new Map<number,number>();
+  private announceAt=0;
+  private turn=0;
+  constructor(private readonly route=0){}
+  start(now:number,party:number){
+    const partyScale=Math.min(4,Math.sqrt(Math.max(1,Math.min(50,Number.isFinite(party)?party:1))));
+    this.counts=rules.waveCounts.map(n=>Math.ceil(n*partyScale));
+    const total=this.counts.reduce((a,b)=>a+b,0);
+    this.state={id:'porch-watch',status:'fighting',wave:0,waves:this.counts.length,defeated:0,total,remaining:total,deadline:now+ticks(rules.deadlineSeconds),portals:[],heldTicks:0,requiredHoldTicks:ticks(rules.holdSeconds),holding:0,contesting:0};
+    this.began=this.lastTick=now;this.stopped=false;
+    this.alive.clear();this.queue=[];this.announceAt=now;this.turn=0;
+  }
+  view():PorchWatchView {
+    return {...this.state,portals:this.state.portals.map(p=>({...p})),...(this.state.hold?{hold:{...this.state.hold}}:{})};
+  }
+  cancel(){this.stopped=true;this.state.portals=[];this.queue=[];this.alive.clear();}
+  fail(){this.state.status='failed';this.cancel();}
+  step(c:PorchWatchContext){
+    if(this.stopped||!Number.isSafeInteger(c.now)||c.now<=this.lastTick)return;
+    this.lastTick=c.now;
+    const s=this.state;
+    if(c.now>=s.deadline){this.fail();return;}
+    s.hold??=porchHoldPoint(c.bounds,c.obstacles,c.lava,this.route);
+    if(!s.hold){this.fail();return;}
+    for(const [id,expires]of this.alive)if(!c.actors.has(id)){
+      if(c.now>=expires){this.fail();return;}
+      this.alive.delete(id);s.defeated++;s.remaining=Math.max(0,s.total-s.defeated);
+    }
+    while(s.wave<this.counts.length&&c.now>=this.began+ticks(rules.waveSeconds[s.wave])){
+      this.queue.push({wave:s.wave+1,count:this.counts[s.wave]});s.wave++;
+    }
+    if(s.portals.length&&c.now>=s.portals[0].at)this.release(c);
+    if(!s.portals.length&&this.queue.length&&c.now>=this.announceAt)this.announce(c);
+    s.status=s.portals.length?'warning':'fighting';
+    s.holding=c.holders.filter(p=>distance(p,s.hold!)<=s.hold!.radius-catalog.rules.playerRadius).length;
+    s.contesting=[...c.actors.values()].filter(a=>a.health>0&&distance(a,s.hold!)<=s.hold!.radius+a.radius).length;
+    if(s.holding>0&&s.contesting===0)s.heldTicks=Math.min(s.requiredHoldTicks,s.heldTicks+1);
+    if(s.heldTicks>=s.requiredHoldTicks){s.status='complete';this.cancel();}
+  }
+  private announce(c:PorchWatchContext){
+    const front=this.queue[0];
+    this.announceAt=c.now+rules.retryTicks;
+    if(!front||c.actors.size>=rules.maximumLive||!c.targets.length)return;
+    const sites=skirmishSites(c.bounds,c.obstacles,c.lava,[...c.targets,this.state.hold!]);
+    if(!sites.length)return;
+    const offset=this.turn++%sites.length;
+    this.state.portals=sites.slice(offset).concat(sites.slice(0,offset))
+      .slice(0,Math.min(front.count,rules.maximumLive-c.actors.size))
+      .map(p=>({...p,at:c.now+ticks(rules.warningSeconds)}));
+  }
+  private release(c:PorchWatchContext){
+    const promised=this.state.portals,front=this.queue[0];this.state.portals=[];
+    this.announceAt=c.now+rules.retryTicks;
+    if(!front)return;
+    for(const point of promised){
+      if(c.actors.size>=rules.maximumLive)break;
+      if(c.targets.some(p=>distance(p,point)<55)||c.obstacles.some(w=>segmentRect(point,point,w,26))||c.lava.some(p=>distance(p,point)<p.radius+26)||[...c.actors.values()].some(a=>distance(a,point)<a.radius+rules.bodyRadius+4))continue;
+      const actor=c.spawn({kind:'ordinary',x:point.x,y:point.y,health:(rules.baseHealth+front.wave*rules.healthPerWave)*scale(c.healthScale),radius:rules.bodyRadius,speed:(rules.baseSpeed+front.wave*rules.speedPerWave)*scale(c.speedScale),damage:rules.baseDamage*scale(c.damageScale),lifeSeconds:600});
+      if(actor){this.alive.set(actor.id,actor.expires);front.count--;}
+    }
+    if(front.count===0)this.queue.shift();
+  }
+}
